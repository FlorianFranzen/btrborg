# NixOS module for btrborg.
#
# Writes /etc/btrborg.conf from the options below and installs a systemd
# service plus timer that runs `btrborg run`. The same configuration file is
# used when btrborg is invoked by hand as root.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.btrborg;

  btrbkInstances = lib.attrNames (config.services.btrbk.instances or { });

  settingType = lib.types.oneOf [
    lib.types.str
    lib.types.int
  ];

  renderSetting = name: value: "${name}=${lib.escapeShellArg (toString value)}";

  configFile = pkgs.writeText "btrborg.conf" (
    lib.concatStringsSep "\n" (
      [
        "# Generated by the NixOS module services.btrborg. Do not edit."
        (renderSetting "BORG_REPO_BASE" cfg.repoBase)
      ]
      ++ lib.optional (cfg.btrbkInstance != null) (
        renderSetting "BTRBORG_BTRBK_ARGS" "-c /etc/btrbk/${cfg.btrbkInstance}.conf"
      )
      ++ lib.mapAttrsToList renderSetting cfg.settings
      ++ lib.optional (
        cfg.environmentFile != null
      ) ". ${lib.escapeShellArg (toString cfg.environmentFile)}"
      ++ [ "" ]
    )
  );
in
{
  options.services.btrborg = {
    enable = lib.mkEnableOption "btrborg, backing up btrbk snapshots into borg repositories";

    package = lib.mkPackageOption pkgs "btrborg" { };

    repoBase = lib.mkOption {
      type = lib.types.str;
      example = "ssh://borg@backup.example.org/./btrbk";
      description = ''
        Location below which the borg repositories live, one per subvolume
        and named after it. Anything borg accepts as a repository location
        works, local paths as well as `ssh://` URLs. Sets `BORG_REPO_BASE`.
      '';
    };

    btrbkInstance = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = if lib.length btrbkInstances == 1 then lib.head btrbkInstances else null;
      defaultText = lib.literalMD ''
        The only instance in {option}`services.btrbk.instances` if there is
        exactly one, otherwise `null`.
      '';
      description = ''
        Name of the {option}`services.btrbk.instances` entry whose
        configuration file btrborg reads to find snapshots. With `null`,
        btrbk's default configuration file is used.
      '';
    };

    environmentFile = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      example = "/run/secrets/btrborg";
      description = ''
        Shell file with secret settings such as `BORG_PASSPHRASE` or
        `BORG_RSH`, sourced at the end of `/etc/btrborg.conf`. Make sure it
        is only readable by root. It is sourced, not merely parsed, so every
        value must be quoted the way a shell expects.
      '';
    };

    settings = lib.mkOption {
      type = lib.types.attrsOf settingType;
      default = { };
      example = lib.literalExpression ''
        {
          BTRBORG_COMPRESSION = "zstd,9";
          BTRBORG_KEEP = "--keep-daily 7 --keep-weekly 4 --keep-monthly 6";
          BORG_REMOTE_PATH = "borg1";
        }
      '';
      description = ''
        Further variables written to `/etc/btrborg.conf`. See
        {manpage}`btrborg.conf(5)` for the `BTRBORG_*` variables and
        {manpage}`borg(1)` for the `BORG_*` ones.
      '';
    };

    onCalendar = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = "daily";
      example = "*-*-* 03:00:00";
      description = ''
        When to run `btrborg run`, as a {manpage}`systemd.time(7)` calendar
        expression. Schedule it after the btrbk instance has taken its
        snapshots; if both run at the same time, the btrborg service is
        ordered after the btrbk services. `null` installs no timer.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.btrbkInstance == null || lib.elem cfg.btrbkInstance btrbkInstances;
        message = "services.btrborg.btrbkInstance refers to the unknown btrbk instance '${toString cfg.btrbkInstance}'.";
      }
    ];

    environment.systemPackages = [ cfg.package ];
    environment.etc."btrborg.conf".source = configFile;

    systemd.services.btrborg = {
      description = "Back up btrbk snapshots into borg repositories";
      unitConfig.Documentation = "man:btrborg(1) man:btrborg.conf(5)";
      after = [
        "local-fs.target"
        "network-online.target"
      ]
      ++ map (name: "btrbk-${name}.service") btrbkInstances;
      wants = [ "network-online.target" ];
      restartIfChanged = false;
      # The btrbk module configures btrbk to call btrfs through sudo, which
      # lives in /run/wrappers.
      path = [
        "/run/wrappers"
        pkgs.btrfs-progs
      ];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = "${lib.getExe cfg.package} run";
        Nice = 10;
        IOSchedulingClass = "best-effort";
        IOSchedulingPriority = 7;
      };
    };

    systemd.timers.btrborg = lib.mkIf (cfg.onCalendar != null) {
      description = "Timer to back up btrbk snapshots into borg repositories";
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnCalendar = cfg.onCalendar;
        AccuracySec = "10min";
        Persistent = true;
      };
    };
  };
}
